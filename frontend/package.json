{
  "name": "go-refine-admin-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:api": "npx -y @openapitools/openapi-generator-cli generate -i ../backend/docs/swagger.json -g typescript-axios -o src/api --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=false"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@refinedev/antd": "^5.45.0",
    "@refinedev/core": "^4.57.0",
    "@refinedev/react-router-v6": "^4.6.0",
    "antd": "^5.21.0",
    "axios": "^1.20.0",
    "i18next": "^26.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0"
  }
}
